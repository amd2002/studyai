nyin": "shú", "meaning_fr": "familier ; mûr"}, {"char": "悉", "pinyin": "xī", "meaning_fr": "connaître (熟悉 bien connaître)"}, {"char": "觉", "pinyin": "jué", "meaning_fr": "sentir (觉得 trouver que)"}, {"char": "得", "pinyin": "de", "meaning_fr": "particule (觉得 trouver que)"}, {"char": "越", "pinyin": "yuè", "meaning_fr": "de plus en plus (越来越)"}, {"char": "趣", "pinyin": "qù", "meaning_fr": "intérêt (有趣 intéressant)"}, {"char": "哪", "pinyin": "nǎ", "meaning_fr": "lequel, où (哪儿)"}, {"char": "儿", "pinyin": "ér", "meaning_fr": "enfant ; suffixe -r (哪儿)"}, {"char": "看", "pinyin": "kàn", "meaning_fr": "regarder"}, {"char": "谢", "pinyin": "xiè", "meaning_fr": "remercier"}]}, {"title": "谈谈你学习汉语的目的", "title_py": "tántan nǐ xuéxí Hànyǔ de mùdì", "title_fr": "Sujet 03 · Parlez du but de votre apprentissage du chinois", "sentences": [{"zh": "大家好，今天我想谈谈我学习汉语的目的。", "py": "Dàjiā hǎo, jīntiān wǒ xiǎng tántan wǒ xuéxí Hànyǔ de mùdì.", "fr": "Bonjour à tous, aujourd'hui je voudrais parler du but de mon apprentissage du chinois."}, {"zh": "我来自几内亚，现在在华南师范大学学习汉语。", "py": "Wǒ láizì Jǐnèiyà, xiànzài zài Huánán Shīfàn Dàxué xuéxí Hànyǔ.", "fr": "Je viens de Guinée et j'étudie actuellement le chinois à l'Université normale de Chine du Sud."}, {"zh": "我学习汉语是为了以后能在中国工作。", "py": "Wǒ xuéxí Hànyǔ shì wèile yǐhòu néng zài Zhōngguó gōngzuò.", "fr": "J'apprends le chinois pour pouvoir travailler en Chine plus tard."}, {"zh": "现在很多非洲人来中国做生意，所以会说汉语的人越来越重要。", "py": "Xiànzài hěn duō Fēizhōu rén lái Zhōngguó zuò shēngyi, suǒyǐ huì shuō Hànyǔ de rén yuè lái yuè zhòngyào.", "fr": "Beaucoup d'Africains viennent faire du commerce en Chine, donc ceux qui parlent chinois sont de plus en plus importants."}, {"zh": "我特别喜欢中国文化，所以希望能说一口流利的中文。", "py": "Wǒ tèbié xǐhuan Zhōngguó wénhuà, suǒyǐ xīwàng néng shuō yì kǒu liúlì de Zhōngwén.", "fr": "J'aime particulièrement la culture chinoise, donc j'espère parler un chinois courant."}, {"zh": "我也想多交一些中国朋友，了解他们的生活。", "py": "Wǒ yě xiǎng duō jiāo yìxiē Zhōngguó péngyou, liǎojiě tāmen de shēnghuó.", "fr": "Je veux aussi me faire plus d'amis chinois et comprendre leur vie."}, {"zh": "为了学好汉语，我每天都很认真。", "py": "Wèile xué hǎo Hànyǔ, wǒ měi tiān dōu hěn rènzhēn.", "fr": "Pour bien apprendre le chinois, je travaille sérieusement chaque jour."}, {"zh": "每天，我先复习生词，然后做练习。", "py": "Měi tiān, wǒ xiān fùxí shēngcí, ránhòu zuò liànxí.", "fr": "Chaque jour, je révise d'abord le vocabulaire, puis je fais des exercices."}, {"zh": "下课以后，我常常和同学一起练习口语。", "py": "Xiàkè yǐhòu, wǒ chángcháng hé tóngxué yìqǐ liànxí kǒuyǔ.", "fr": "Après les cours, je pratique souvent l'oral avec mes camarades."}, {"zh": "我还喜欢一边听中文歌，一边学汉语，这让我觉得很放松。", "py": "Wǒ hái xǐhuan yìbiān tīng Zhōngwén gē, yìbiān xué Hànyǔ, zhè ràng wǒ juéde hěn fàngsōng.", "fr": "J'aime aussi apprendre le chinois en écoutant des chansons chinoises, ça me détend."}, {"zh": "有时候我也一边看中国电视剧，一边学习新的词语。", "py": "Yǒu shíhou wǒ yě yìbiān kàn Zhōngguó diànshìjù, yìbiān xuéxí xīn de cíyǔ.", "fr": "Parfois je regarde aussi des séries chinoises tout en apprenant de nouveaux mots."}, {"zh": "虽然汉语很难，特别是声调和汉字，但是我不想放弃。", "py": "Suīrán Hànyǔ hěn nán, tèbié shì shēngdiào hé Hànzì, dànshì wǒ bù xiǎng fàngqì.", "fr": "Même si le chinois est difficile, surtout les tons et les caractères, je ne veux pas abandonner."}, {"zh": "我相信只要努力，就一定能学好。谢谢大家！", "py": "Wǒ xiāngxìn zhǐyào nǔlì, jiù yídìng néng xué hǎo. Xièxie dàjiā!", "fr": "Je crois que tant que je travaille dur, je réussirai à bien l'apprendre. Merci à tous !"}], "words": [], "grammar": [], "characters": [{"char": "谈", "pinyin": "tán", "meaning_fr": "parler de, discuter"}, {"char": "你", "pinyin": "nǐ", "meaning_fr": "tu, toi"}, {"char": "学", "pinyin": "xué", "meaning_fr": "apprendre, étudier"}, {"char": "习", "pinyin": "xí", "meaning_fr": "pratiquer (学习, 复习)"}, {"char": "汉", "pinyin": "hàn", "meaning_fr": "Han, chinois (汉语)"}, {"char": "语", "pinyin": "yǔ", "meaning_fr": "langue (汉语)"}, {"char": "的", "pinyin": "de", "meaning_fr": "particule du possessif / de liaison"}, {"char": 