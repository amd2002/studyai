[{"title": "谈你最喜欢的一家饭店", "title_py": "tán nǐ zuì xǐhuan de yì jiā fàndiàn", "title_fr": "Sujet 01 · Parlez de votre restaurant préféré", "sentences": [{"zh": "大家好，今天我想谈谈我最喜欢的一家饭店。", "py": "Dàjiā hǎo, jīntiān wǒ xiǎng tántan wǒ zuì xǐhuan de yì jiā fàndiàn.", "fr": "Bonjour à tous, aujourd'hui je voudrais parler de mon restaurant préféré."}, {"zh": "我最喜欢的一家饭店是学校附近的一家四川菜馆。", "py": "Wǒ zuì xǐhuan de yì jiā fàndiàn shì xuéxiào fùjìn de yì jiā Sìchuān càiguǎn.", "fr": "Mon restaurant préféré est un restaurant sichuanais près de l'école."}, {"zh": "我常常和同学一起去，走路只要十分钟。", "py": "Wǒ chángcháng hé tóngxué yìqǐ qù, zǒulù zhǐ yào shí fēnzhōng.", "fr": "J'y vais souvent avec des camarades, c'est à seulement dix minutes à pied."}, {"zh": "那里的环境非常舒适，服务员也很热情、周到。", "py": "Nàlǐ de huánjìng fēicháng shūshì, fúwùyuán yě hěn rèqíng, zhōudào.", "fr": "L'ambiance y est très agréable, et les serveurs sont chaleureux et attentionnés."}, {"zh": "每次我去那里，一拿起菜谱，就觉得非常饿。", "py": "Měi cì wǒ qù nàlǐ, yì ná qǐ càipǔ, jiù juéde fēicháng è.", "fr": "Chaque fois que j'y vais, dès que je prends le menu, j'ai tout de suite très faim."}, {"zh": "那里的菜很多，有鱼、有肉，也有很多青菜。", "py": "Nàlǐ de cài hěn duō, yǒu yú, yǒu ròu, yě yǒu hěn duō qīngcài.", "fr": "Il y a beaucoup de plats : du poisson, de la viande, et aussi beaucoup de légumes."}, {"zh": "我通常会点一道麻婆豆腐。", "py": "Wǒ tōngcháng huì diǎn yí dào mápó dòufu.", "fr": "Je commande généralement un mapo tofu."}, {"zh": "虽然我不太能吃辣，但是这道菜真的很地道，又好吃又便宜。", "py": "Suīrán wǒ bú tài néng chī là, dànshì zhè dào cài zhēn de hěn dìdao, yòu hǎochī yòu piányi.", "fr": "Bien que je ne supporte pas trop le piquant, ce plat est vraiment authentique, à la fois délicieux et bon marché."}, {"zh": "吃辣的时候，我一边吃一边喝水。", "py": "Chī là de shíhou, wǒ yìbiān chī yìbiān hē shuǐ.", "fr": "Quand je mange épicé, je bois de l'eau en même temps."}, {"zh": "不过，有时候菜的分量太大了，我一个人实在吃不了。", "py": "Búguò, yǒu shíhou cài de fènliàng tài dà le, wǒ yí ge rén shízài chī bu liǎo.", "fr": "Cependant, les portions sont parfois trop grandes : seul, je n'arrive vraiment pas à tout finir."}, {"zh": "所以我常常把剩下的菜打包带回宿舍。", "py": "Suǒyǐ wǒ chángcháng bǎ shèngxià de cài dǎbāo dài huí sùshè.", "fr": "Donc j'emporte souvent les restes au dortoir."}, {"zh": "总的来说，这是一家非常好的饭馆。", "py": "Zǒng de lái shuō, zhè shì yì jiā fēicháng hǎo de fànguǎn.", "fr": "Dans l'ensemble, c'est un très bon restaurant."}, {"zh": "如果你有机会来广州，我一定带你去尝尝。谢谢大家！", "py": "Rúguǒ nǐ yǒu jīhuì lái Guǎngzhōu, wǒ yídìng dài nǐ qù chángchang. Xièxie dàjiā!", "fr": "Si tu as l'occasion de venir à Guangzhou, je t'y emmènerai goûter. Merci à tous !"}], "words": [], "grammar": [], "characters": [{"char": "谈", "pinyin": "tán", "meaning_fr": "parler de, discuter"}, {"char": "你", "pinyin": "nǐ", "meaning_fr": "tu, toi"}, {"char": "最", "pinyin": "zuì", "meaning_fr": "le plus"}, {"char": "喜", "pinyin": "xǐ", "meaning_fr": "joie ; aimer (喜欢)"}, {"char": "欢", "pinyin": "huān", "meaning_fr": "joyeux ; aimer (喜欢)"}, {"char": "的", "pinyin": "de", "meaning_fr": "particule du possessif / de liaison"}, {"char": "一", "pinyin": "yī", "meaning_fr": "un"}, {"char": "家", "pinyin": "jiā", "meaning_fr": "famille, maison ; classificateur des commerces"}, {"char": "饭", "pinyin": "fàn", "meaning_fr": "repas ; riz cuit"}, {"char": "店", "pinyin": "diàn", "meaning_fr": "magasin, boutique"}, {"char": "大", "pinyin": "dà", "meaning_fr": "grand"}, {"char": "好", "pinyin": "hǎo", "meaning_fr": "bien, bon"}, {"char": "今", "pinyin": "jīn", "meaning_fr": "aujourd'hui, maintenant (今天)"}, {"char": "天", "pinyin": "tiān", "meaning_fr": "jour ; ciel"}, {"char": "我", "pinyin": "wǒ", "meaning_fr": "je, moi"}, {"char": "想", "pinyin": "xiǎng", "meaning_fr": "vouloir ; penser"}, {"char": "是", "pinyin": "shì", "meaning_fr": "être"}, {"char": "学", "pinyin": "xué", "meaning_fr": "apprendre, étudier"}, {"char": "校", "pinyin": "xiào", "meaning_fr": "école (学校)"}, {"char": "附", "pinyin": "fù", "meaning_fr": "proche (附近)"}, {"char": "近", "pinyin": "jìn", "meaning_fr": "près, proche"}, {"char": "四", "pinyin": "sì", "meaning_fr": "quatre"}, {"char": "川", "pinyin": "chuān", "meaning_fr": "rivière ; Sichuan (四川)"}, {"char": "菜", "pinyin": "cài", "meaning_fr": "plat ; légume"}, {"char": "馆", "pinyin": "guǎn", "meaning_fr": "établissement (restaurant, bibliothèque…)"}, {"char": "常", "pinyin": "cháng", "meaning_fr": "souvent (常常)"}, {"char": "和", "pinyin": "hé", "meaning_fr": "et ; avec"}, {"char": "同", "pinyin": "tóng", "meaning_fr": "même ; ensemble (同学 camarade)"}, {"char": "起", "pinyin": "qǐ", "meaning_fr": "se lever ; ensemble (一起)"}, {"char": "去", "pinyin": "qù", "meaning_fr": "aller"}, {"char": "走", "pinyin": "zǒu", "meaning_fr": "marcher ; partir"}, {"char": "路", "pinyin": "lù", "meaning_fr": "route, chemin"}, {"char": "只", "pinyin": "zhǐ", "meaning_fr": "seulement"}, {"char": "要", "pinyin": "yào", "meaning_fr": "vouloir ; falloir"}, {"char": "十", "pinyin": "shí", "meaning_fr": "dix"}, {"char": "分", "pinyin": "fēn", "meaning_fr": "minute ; diviser"}, {"char": "钟", "pinyin": "zhōng", "meaning_fr": "horloge ; heure (分钟 minute)"}, {"char": "那", "pinyin": "nà", "meaning_fr": "cela, là-bas"}, {"char": "里", "pinyin": "lǐ", "meaning_fr": "dans, intérieur"}, {"char": "环", "pinyin": "huán", "meaning_fr": "anneau ; environnement (环境)"}, {"char": "境", "pinyin": "jìng", "meaning_fr": "frontière ; situation (环境)"}, {"char": "非", "pinyin": "fēi", "meaning_fr": "non ; très (非常)"}, {"char": "舒", "pinyin": "shū", "meaning_fr": "détendu (舒适 confortable)"}, {"char": "适", "pinyin": "shì", "meaning_fr": "convenir (舒适 confortable)"}, {"char": "服", "pinyin": "fú", "meaning_fr": "vêtement ; servir (服务)"}, {"char": "务", "pinyin": "wù", "meaning_fr": "affaire ; service (服务)"}, {"char": "员", "pinyin": "yuán", "meaning_fr": "employé, membre (服务员 serveur)"}, {"char": "也", "pinyin": "yě", "meaning_fr": "aussi"}, {"char": "很", "pinyin": "hěn", "meaning_fr": "très"}, {"char": "热", "pinyin": "rè", "meaning_fr": "chaud"}, {"char": "情", "pinyin": "qíng", "meaning_fr": "sentiment (